@init
// Active-note bookkeeping: [channel * 128 + input note] * 5 stores count
// followed by the four generated MIDI notes.
memset(0, -1, 16 * 128 * 5);

function scale_len(sc) (
  sc == 7 ? 12 : 7;
);

function scale_semitone(sc, degree_index) local(oct, idx, val) (
  sc == 7 ? degree_index : (
    oct = floor(degree_index / 7);
    idx = degree_index % 7;
    sc == 0 ? (
      idx == 0 ? val=0 : idx == 1 ? val=2 : idx == 2 ? val=4 :
      idx == 3 ? val=5 : idx == 4 ? val=7 : idx == 5 ? val=9 : val=11;
    ) : sc == 1 ? (
      idx == 0 ? val=0 : idx == 1 ? val=2 : idx == 2 ? val=3 :
      idx == 3 ? val=5 : idx == 4 ? val=7 : idx == 5 ? val=8 : val=10;
    ) : sc == 2 ? (
      idx == 0 ? val=0 : idx == 1 ? val=2 : idx == 2 ? val=3 :
      idx == 3 ? val=5 : idx == 4 ? val=7 : idx == 5 ? val=9 : val=10;
    ) : sc == 3 ? (
      idx == 0 ? val=0 : idx == 1 ? val=2 : idx == 2 ? val=4 :
      idx == 3 ? val=5 : idx == 4 ? val=7 : idx == 5 ? val=9 : val=10;
    ) : sc == 4 ? (
      idx == 0 ? val=0 : idx == 1 ? val=1 : idx == 2 ? val=3 :
      idx == 3 ? val=5 : idx == 4 ? val=7 : idx == 5 ? val=8 : val=10;
    ) : sc == 5 ? (
      idx == 0 ? val=0 : idx == 1 ? val=2 : idx == 2 ? val=4 :
      idx == 3 ? val=6 : idx == 4 ? val=7 : idx == 5 ? val=9 : val=11;
    ) : (
      idx == 0 ? val=0 : idx == 1 ? val=1 : idx == 2 ? val=3 :
      idx == 3 ? val=5 : idx == 4 ? val=6 : idx == 5 ? val=8 : val=10;
    );
    val + oct * 12;
  );
);

// Find the pressed note's position in the chosen global scale. If it is
// outside the scale, use the pressed note as a temporary chromatic root while
// retaining the selected scale's interval pattern.
function find_degree(note, tonic, sc) local(pc, i, found) (
  sc == 7 ? (note - tonic) : (
    pc = (note - tonic) % 12;
    pc < 0 ? pc += 12;
    found = -1;
    i = 0;
    loop(7,
      scale_semitone(sc, i) == pc ? found = i;
      i += 1;
    );
    found;
  );
);

function round_note_down(note, tonic, sc) local(candidate, degree, tries) (
  sc == 7 ? note : (
    candidate = note;
    degree = find_degree(candidate, tonic, sc);
    tries = 0;
    while(degree < 0 && tries < 12) (
      candidate -= 1;
      degree = find_degree(candidate, tonic, sc);
      tries += 1;
    );
    candidate;
  );
);

